{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouGet",
  "version": "../package.json",
  "identifier": "io.github.luckyshot.youget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouGet",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Download videos and audio with yt-dlp",
    "longDescription": "YouGet is a desktop GUI for yt-dlp: drop links, pick video or audio, and download with a queue, parallel downloads and live progress. It keeps yt-dlp up to date automatically.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
