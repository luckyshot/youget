# Builds YouGet from this source checkout:
#   cd packaging/arch && makepkg -si
pkgname=youget
pkgver=0.1.1
pkgrel=1
pkgdesc="Desktop GUI for yt-dlp: drop links, pick video or audio, download with a queue"
arch=('x86_64' 'aarch64')
url="https://github.com/luckyshot/youget"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'ffmpeg' 'deno' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
options=('!lto' '!debug')

_root() { realpath "$startdir/../.."; }

build() {
  cd "$(_root)"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  local r
  r="$(_root)"
  install -Dm755 "$r/src-tauri/target/release/youget" "$pkgdir/usr/bin/youget"
  install -Dm644 "$r/packaging/linux/youget.desktop" "$pkgdir/usr/share/applications/youget.desktop"
  install -Dm644 "$r/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/youget.png"
  install -Dm644 "$r/src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/youget.png"
  install -Dm644 "$r/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/youget.png"
  install -Dm644 "$r/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/youget.png"
  install -Dm644 "$r/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/youget.png"
  install -Dm644 "$r/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
